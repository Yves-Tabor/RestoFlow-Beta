rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Analytics collection - read/write for testing (allow unauthenticated)
    match /analytics/{date} {
      allow read, write: if true;
    }
    
    // Orders collection - read/write for testing (allow unauthenticated)
    match /orders/{orderId} {
      allow read, write: if true;
      allow create: if request.auth != null && 
        request.auth.uid != null &&
        request.resource.data.keys().hasAll(['id', 'items', 'subtotal', 'serviceCharge', 'total', 'status', 'timestamp']) &&
        request.resource.data.id is string &&
        request.resource.data.items is list &&
        request.resource.data.subtotal is number &&
        request.resource.data.serviceCharge is number &&
        request.resource.data.total is number &&
        request.resource.data.status in ['pending', 'completed'];
      allow update: if request.auth != null && 
        request.auth.uid != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'completed'];
    }
    
    // Menu items collection - read-only for all authenticated users
    match /menuItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Stock collection - read/write for testing (allow unauthenticated)
    match /stock/{stockId} {
      allow read, write: if true;
    }
    
    // Staff collection - read/write for authenticated users
    match /staff/{staffId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
